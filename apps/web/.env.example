# ── Data source ─────────────────────────────────────────────
# mock = typed fixtures (lib/api/mock). http = real backend (apps/api).
NEXT_PUBLIC_DATA_SOURCE=mock
NEXT_PUBLIC_API_URL=http://localhost:8787

# ── Chain (Ethereum Sepolia) ────────────────────────────────
NEXT_PUBLIC_CHAIN_ID=11155111
NEXT_PUBLIC_SEPOLIA_RPC_URL=
NEXT_PUBLIC_EXPLORER_URL=https://sepolia.etherscan.io
NEXT_PUBLIC_VAULT_ADDRESS=
# Optional: enables WalletConnect wallets in RainbowKit (injected wallets work without it)
NEXT_PUBLIC_WC_PROJECT_ID=

# ── ENS identity ────────────────────────────────────────────
NEXT_PUBLIC_ENS_NAME=ops.alactic.eth
NEXT_PUBLIC_ENS_RECORD_PREFIX=alactic
